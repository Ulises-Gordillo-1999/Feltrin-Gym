# ─── Base de datos ───────────────────────────────────────────────
# Desarrollo: docker compose (puerto 5433). Producción: URL interna del recurso PostgreSQL en Coolify.
DATABASE_URL=postgres://feltrin:feltrin_dev_password@localhost:5433/feltrin_gym
PORT=3001

# ─── Autenticación ───────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Duración de la sesión en horas
SESSION_TTL_HOURS=12

# ─── Archivos subidos (fotos WebP) ───────────────────────────────
# En Coolify montar un volumen persistente en /app/uploads
UPLOADS_DIR=./uploads

# ─── Zona horaria del negocio ────────────────────────────────────
TZ=America/Argentina/Buenos_Aires

# ─── Admin inicial (usado solo por `npm run db:seed`) ────────────
SEED_ADMIN_EMAIL=admin@feltrin.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Administrador Feltrin
